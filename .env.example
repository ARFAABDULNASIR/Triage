# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DATABASE_URL=postgres://user:pass@localhost:5432/meetingtotickets

# Local dev without Docker
USE_SQLITE=True
CELERY_TASK_ALWAYS_EAGER=True

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# --- AI providers (both free, at least one recommended) ---
# Groq (primary) — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (fallback) — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Local Whisper fallback for audio/video when Groq is unavailable
# (tiny/base/small/medium — downloaded on first use)
FASTER_WHISPER_MODEL=small

# Encryption key for Linear/Jira credentials (generate with Fernet.generate_key())
CREDENTIALS_ENCRYPTION_KEY=
